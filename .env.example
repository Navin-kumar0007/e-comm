DATABASE_URL="postgresql://user:password@localhost:5432/nuttyworld?schema=public"
AUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"
RAZORPAY_KEY_ID="rzp_test_xxxx"
RAZORPAY_KEY_SECRET="xxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxx"
# Razorpay Dashboard > Settings > Webhooks (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET="xxxx"
# Bearer token for /api/cron/release-stale-orders (run every ~10 min)
CRON_SECRET="long_random_string"
GEMINI_API_KEY="your_gemini_api_key_here"
ALLOW_MOCK_PAYMENTS="true"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Delivery partner: Xpressbees API user (enables auto booking, labels, tracking, pincode checks)
XPRESSBEES_EMAIL=""
XPRESSBEES_PASSWORD=""
# XPRESSBEES_BASE_URL="https://shipment.xpressbees.com/api"
# Token in courier status webhook URL: /api/webhooks/shipping/xpressbees?token=<this>
SHIPPING_WEBHOOK_SECRET="long_random_string"
