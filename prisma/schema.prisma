// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                  String           @id @default(cuid())
  name                String
  slug                String           @unique
  description         String
  price               Float
  salePrice           Float?
  images              String // Stored as JSON string array
  weight              String?
  stock               Int              @default(100)
  status              String           @default("ACTIVE")
  isOrganic           Boolean          @default(true)
  isFeatured          Boolean          @default(false)
  tags                String // Stored as comma-separated string
  categoryId          String
  category            Category         @relation(fields: [categoryId], references: [id])
  slogan              String?
  ingredients         String?
  nutritionalInfo     String?
  manufacturedDetails String?
  barcode             String?
  mrp                 Float?
  priceAlerts         PriceAlert[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  orderItems          OrderItem[]
  reviews             Review[]
  recipes             Recipe[]         @relation("RecipeProducts")
  dietaryTags         DietaryTag[]     @relation("ProductDietaryTags")
  labelSettings       String?
  shippingWeightGrams Int? // Packed weight for courier booking; falls back to parsing `weight`
  costPrice           Float? // Purchase cost per unit, for margin reports
  lowStockThreshold   Int              @default(10)
  hsnCode             String? // HSN for GST invoices, e.g. 0802
  gstRate             Float? // % GST; null = store default (Settings.gstRate)
  variants            ProductVariant[]
  stockMovements      StockMovement[]
  materials           Material[]
  purchaseLines       PurchaseLine[]
  lots                StockLot[]

  @@index([categoryId])
  @@index([status])
  @@index([slug])
}

model User {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  password          String?
  provider          String? // "credentials" or "google"
  image             String? // Google profile picture URL
  role              String         @default("USER") // USER or ADMIN
  points            Int            @default(0)
  address           String?
  city              String?
  state             String?
  pincode           String?
  phone             String?
  whatsappOptIn     Boolean        @default(true)
  customerType      String         @default("RETAIL") // RETAIL, WHOLESALE
  businessName      String?
  gstin             String? // business buyer's GSTIN, printed on their invoices
  wholesaleDiscount Float? // % off retail prices on manual orders
  totpSecret        String? // two-step login secret (encrypted)
  totpEnabledAt     DateTime?
  totpBackupCodes   String? // JSON array of SHA-256 hashes of one-time codes
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  orders            Order[]
  recipes           Recipe[]
  reviews           Review[]
  blogPosts         BlogPost[]
  notifications     Notification[]
  dietaryTags       DietaryTag[]   @relation("UserDietaryTags")
  subscriptions     Subscription[]
}

model Recipe {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  image       String
  category    String // Breakfast, Main Course, etc
  status      String    @default("APPROVED") // PENDING, APPROVED, REJECTED
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  prepTime    String
  cookTime    String
  servings    Int
  difficulty  String
  ingredients String // Stored as JSON string array of objects
  steps       String // Stored as JSON string array
  tags        String // Stored as comma-separated string
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] @relation("RecipeProducts")
}

model Order {
  id              String          @id @default(cuid())
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  items           OrderItem[]
  shipments       Shipment[]
  events          OrderEvent[]
  refunds         Refund[]
  returnRequests  ReturnRequest[]
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  refundedAmount  Float           @default(0)
  cashbackPending Boolean         @default(false) // true until delivery credits the cashback
  cashbackPoints  Int             @default(0) // cashback credited (reversed on return)
  total           Float
  status          String          @default("PENDING") // PENDING, PROCESSING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED, EXPIRED, DELETED
  paymentMethod   String          @default("ONLINE") // ONLINE, COD
  razorpayOrderId String?
  paymentId       String?
  paidAt          DateTime?
  subtotal        Float? // Item total before discounts (null on legacy orders)
  shippingFee     Float           @default(0)
  taxAmount       Float           @default(0) // GST included in total (prices are tax-inclusive)
  shippingState   String?
  invoiceNumber   String?         @unique
  discount        Float           @default(0)
  couponCode      String?
  pointsUsed      Int             @default(0)
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  trackingNumber  String?
  trackingUrl     String?
  invoiceNotes    String?
  customerGstin   String? // B2B buyer GSTIN, printed on the tax invoice
  paymentFee      Float? // Razorpay fee incl. GST on the fee, ₹
  paymentFeeTax   Float? // GST part of that fee (input tax credit)
  settledAt       DateTime? // Razorpay paid this order's money into the bank
  settlementId    String?
  settlementUtr   String?
  codRemittanceId String?
  codRemittance   CodRemittance?  @relation(fields: [codRemittanceId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([customerEmail])
  @@index([razorpayOrderId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String   @default("Product")
  variantId   String?
  quantity    Int
  price       Float
  weight      String
  hsnCode     String? // snapshot at sale, for the invoice
  gstRate     Float? // snapshot at sale (%)

  @@index([orderId])
  @@index([productId])
}

model Settings {
  id                    String  @id @default("default")
  storeName             String
  contactEmail          String
  storeDescription      String
  freeShippingThreshold Float
  flatShippingRate      Float
  gstRate               Float
  currency              String  @default("INR")
  gstin                 String?
  legalName             String?
  businessAddress       String?
  businessState         String?
  invoicePrefix         String  @default("SN")

  // Shipping / delivery partner
  shippingProvider          String  @default("MANUAL") // MANUAL, XPRESSBEES, ...
  pickupName                String?
  pickupPhone               String?
  pickupAddress             String?
  pickupCity                String?
  pickupState               String?
  pickupPincode             String?
  defaultPackageWeightGrams Int     @default(500)
  packageLengthCm           Int     @default(20)
  packageBreadthCm          Int     @default(15)
  packageHeightCm           Int     @default(10)
  codEnabled                Boolean @default(true)
  codMaxOrderValue          Float   @default(5000)
  returnWindowHours         Int     @default(48)

  // Invoice / compliance
  fssaiLicense  String?
  signatoryName String?
  invoiceTerms  String?
}

// Sequential GST invoice numbers, one row per financial year (e.g. "2026-27").
model InvoiceCounter {
  id  String @id
  seq Int    @default(0)
}

model PriceAlert {
  id        String   @id @default(cuid())
  email     String
  phone     String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id               String   @id @default(cuid())
  rating           Int
  comment          String?
  images           String? // Stored as JSON string array of image URLs
  userName         String? // Reviewer display name (supports guest reviews)
  userEmail        String? // Optional email for verified badge
  status           String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  verifiedPurchase Boolean  @default(false)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String // PERCENTAGE, FIXED
  discountValue  Float
  active         Boolean   @default(true)
  expiryDate     DateTime?
  minPurchase    Float?
  maxDiscount    Float? // cap for percentage coupons
  usageLimit     Int? // total redemptions allowed (null = unlimited)
  perUserLimit   Int? // per customer (by account or email)
  usedCount      Int       @default(0)
  firstOrderOnly Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  image     String?
  category  String
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ, REPLIED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, PROMO, ORDER
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DietaryProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  isVegan      Boolean @default(false)
  isGlutenFree Boolean @default(false)
  isNutFree    Boolean @default(false)
}

model CustomBlend {
  id        String  @id @default(cuid())
  userId    String?
  name      String
  base      String
  heat      String
  aromatics String
  price     Float
}

model Batch {
  id          String   @id @default(cuid())
  batchNumber String   @unique
  productId   String
  farmName    String
  harvestDate DateTime
}

model MealPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  planData  String // JSON string mapping day of week to Recipe ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DietaryTag {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[] @relation("ProductDietaryTags")
  users       User[]    @relation("UserDietaryTags")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  boxType          String // e.g., "Standard Box", "Family Box"
  status           String   @default("ACTIVE") // ACTIVE, CANCELLED
  price            Float
  nextDeliveryDate DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  otpHash   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}

model WhatsAppSubscriber {
  id                    String   @id @default(cuid())
  phone                 String   @unique
  name                  String?
  subscribedOffers      Boolean  @default(true)
  subscribedNewReleases Boolean  @default(true)
  subscribedPriceDrops  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model WhatsAppLog {
  id        String   @id @default(cuid())
  phone     String
  message   String
  type      String // "OFFER", "NEW_RELEASE", "PRICE_UPDATE", "ORDER_UPDATE", "WELCOME"
  status    String // "SENT", "SIMULATED", "FAILED"
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([type])
}

model Shipment {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider           String // MANUAL, XPRESSBEES, ...
  type               String    @default("FORWARD") // FORWARD, RETURN
  status             String    @default("CREATED") // see src/lib/shipping/status.ts
  awb                String?
  courierName        String?
  trackingUrl        String?
  labelUrl           String?
  providerShipmentId String?
  weightGrams        Int?
  codAmount          Float     @default(0)
  charge             Float?
  events             String    @default("[]") // JSON array of tracking events
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([orderId])
  @@index([awb])
  @@index([status])
}

// Audit trail for everything that happens to an order.
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String // STATUS, PAYMENT, SHIPMENT, REFUND, RETURN, NOTE
  fromStatus String?
  toStatus   String?
  message    String
  actor      String // "system", "customer", "admin:<email>", "courier:<provider>"
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount           Float
  method           String // RAZORPAY, MANUAL (COD: bank/UPI transfer by admin)
  status           String   @default("PENDING") // PENDING, PROCESSED, FAILED
  reason           String
  razorpayRefundId String?
  reference        String? // UTR / transfer reference for manual refunds
  actor            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([razorpayRefundId])
}

model ReturnRequest {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String?
  reason     String // DAMAGED, WRONG_ITEM, MISSING_ITEM, QUALITY, OTHER
  details    String
  images     String   @default("[]") // JSON array of photo URLs
  status     String   @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, RESOLVED
  resolution String? // REFUND, REPLACEMENT
  adminNote  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Optional pack sizes (e.g. 100g / 250g / 500g). When a product has active
// variants, Product.price/salePrice mirror the default variant and
// Product.stock is the sum of variant stock, so listings keep working.
model ProductVariant {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  label          String // "250g"
  price          Float
  salePrice      Float?
  mrp            Float?
  costPrice      Float?
  stock          Int             @default(0)
  sku            String?
  barcode        String?         @unique // EAN-13 (in-store 2xxxx or GS1 890xxxx)
  weightGrams    Int?
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  purchaseLines  PurchaseLine[]
  lots           StockLot[]

  @@index([productId])
}

// Every stock change, with why it happened. Sum of deltas = current stock.
model StockMovement {
  id           String          @id @default(cuid())
  productId    String
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  delta        Int // + in, - out
  balanceAfter Int?
  reason       String // SALE, RELEASE, CANCEL_RESTOCK, RTO_RESTOCK, RESTOCK, DAMAGE, CORRECTION, ADMIN_ORDER, OPENING
  orderId      String?
  note         String?
  actor        String
  createdAt    DateTime        @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
}

// ───────────── Warehouse ─────────────

model Supplier {
  id          String            @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  gstin       String?
  address     String?
  state       String?
  leadDays    Int               @default(7) // usual days from order to delivery
  notes       String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  purchases   PurchaseOrder[]
  lots        StockLot[]
  payments    SupplierPayment[]
}

// Bulk stock bought by weight (e.g. 25 kg almond bags), packed into jars and pouches.
model Material {
  id            String             @id @default(cuid())
  name          String             @unique
  unit          String             @default("kg")
  productId     String? // the product it is packed into
  product       Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  stockQty      Float              @default(0)
  avgCost       Float              @default(0) // ₹ per unit, weighted average
  reorderLevel  Float              @default(0)
  hsnCode       String?
  gstRate       Float?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  lots          StockLot[]
  movements     MaterialMovement[]
  purchaseLines PurchaseLine[]
  repacks       RepackRun[]
}

model PurchaseOrder {
  id                  String            @id @default(cuid())
  number              String            @unique // PO-2026-0001
  supplierId          String
  supplier            Supplier          @relation(fields: [supplierId], references: [id])
  status              String            @default("DRAFT") // DRAFT, ORDERED, PARTIAL, RECEIVED, CANCELLED
  orderDate           DateTime          @default(now())
  expectedDate        DateTime?
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?
  notes               String?
  subtotal            Float             @default(0)
  taxTotal            Float             @default(0)
  freight             Float             @default(0)
  total               Float             @default(0)
  paidAmount          Float             @default(0)
  createdBy           String
  receivedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lines               PurchaseLine[]
  lots                StockLot[]
  payments            SupplierPayment[]

  @@index([supplierId])
  @@index([status])
}

// One line of a purchase: either bulk material (kg) or finished packs (pcs).
model PurchaseLine {
  id          String          @id @default(cuid())
  poId        String
  po          PurchaseOrder   @relation(fields: [poId], references: [id], onDelete: Cascade)
  materialId  String?
  material    Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description String
  unit        String // kg, pcs
  qty         Float
  rate        Float // ₹ per unit before GST
  gstRate     Float           @default(0)
  receivedQty Float           @default(0)

  @@index([poId])
}

// A batch of stock that arrived or was packed together, with its expiry. Sold first-expiry-first-out.
model StockLot {
  id          String          @id @default(cuid())
  lotNumber   String          @unique // B2610-001, the code stamped on the pack
  kind        String // MATERIAL, PACK
  materialId  String?
  material    Material?       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplierId  String?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  poId        String?
  po          PurchaseOrder?  @relation(fields: [poId], references: [id], onDelete: SetNull)
  repackRunId String?
  qtyIn       Float
  qtyLeft     Float
  unitCost    Float           @default(0) // ₹ per kg (material) or per pack
  mfgDate     DateTime?
  expiryDate  DateTime?
  source      String // PURCHASE, REPACK, OPENING
  note        String?
  actor       String
  receivedAt  DateTime        @default(now())
  allocations LotAllocation[]

  @@index([productId, variantId])
  @@index([materialId])
  @@index([expiryDate])
}

// Which lot each unit sold came from: batch-to-customer tracing for recalls, and true cost of goods sold.
model LotAllocation {
  id         String   @id @default(cuid())
  lotId      String
  lot        StockLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  orderId    String?
  movementId String?
  qty        Float
  unitCost   Float    @default(0)
  createdAt  DateTime @default(now())

  @@index([lotId])
  @@index([orderId])
}

// Every change to bulk material stock. Sum of deltas = Material.stockQty.
model MaterialMovement {
  id           String   @id @default(cuid())
  materialId   String
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  lotId        String?
  delta        Float
  balanceAfter Float
  reason       String // PURCHASE, REPACK, WASTAGE, CORRECTION, OPENING
  refId        String? // PO or repack run
  note         String?
  actor        String
  createdAt    DateTime @default(now())

  @@index([materialId, createdAt])
}

// Bulk → packs: e.g. 10 kg almonds → 38 × 250 g jars + 0.4 kg wastage.
model RepackRun {
  id          String   @id @default(cuid())
  number      String   @unique // RP-2026-0001
  materialId  String
  material    Material @relation(fields: [materialId], references: [id])
  inputQty    Float // kg taken from bulk
  outputQty   Float // kg that went into packs
  wastageQty  Float
  costPerKg   Float // bulk cost of the input, ₹/kg
  packingCost Float    @default(0) // jar + label + seal, ₹ per pack
  outputs     String // JSON [{productId, variantId, label, packs, grams, lotId, lotNumber, unitCost}]
  notes       String?
  actor       String
  createdAt   DateTime @default(now())

  @@index([materialId])
}

model StockCount {
  id        String           @id @default(cuid())
  number    String           @unique // SC-2026-0001
  status    String           @default("OPEN") // OPEN, POSTED, CANCELLED
  notes     String?
  createdBy String
  createdAt DateTime         @default(now())
  postedAt  DateTime?
  postedBy  String?
  lines     StockCountLine[]
}

model StockCountLine {
  id         String     @id @default(cuid())
  countId    String
  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  kind       String // PACK, MATERIAL
  productId  String?
  variantId  String?
  materialId String?
  name       String
  unit       String     @default("pcs")
  expected   Float
  counted    Float?
  unitCost   Float      @default(0)

  @@index([countId])
}

// ───────────── Money ─────────────

// Running costs: packaging, courier, rent, salaries, ads, utilities…
model Expense {
  id          String    @id @default(cuid())
  date        DateTime
  category    String // see src/lib/finance-core.ts EXPENSE_CATEGORIES
  description String
  vendor      String?
  vendorGstin String?
  billNo      String?
  amount      Float // before GST
  gstAmount   Float     @default(0)
  total       Float
  paidVia     String // CASH, UPI, BANK, CARD, UNPAID
  paidAt      DateTime?
  notes       String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
  @@index([category])
}

model SupplierPayment {
  id         String         @id @default(cuid())
  supplierId String
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  poId       String?
  po         PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  date       DateTime
  amount     Float
  method     String // CASH, UPI, BANK, CHEQUE
  reference  String?
  note       String?
  createdBy  String
  createdAt  DateTime       @default(now())

  @@index([supplierId])
  @@index([poId])
  @@index([date])
}

// Money the courier paid us for cash-on-delivery orders.
model CodRemittance {
  id        String   @id @default(cuid())
  courier   String
  date      DateTime
  expected  Float // COD value of the orders it covers
  amount    Float // actually received in the bank
  reference String? // UTR
  note      String?
  createdBy String
  createdAt DateTime @default(now())
  orders    Order[]

  @@index([date])
}

// Who changed what in the admin, and when.
model AuditLog {
  id        String   @id @default(cuid())
  actor     String // role:email
  action    String // e.g. product.update, settings.update, refund.issue
  entity    String? // Product, Order, Settings…
  entityId  String?
  summary   String
  data      String? // JSON details (before / after)
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actor])
}
